# Copy to .env (git-ignored) or set these in the Render dashboard.

# Telegram (required)
TELEGRAM_BOT_TOKEN=123456:replace-me
WEBHOOK_URL=https://your-render-service.onrender.com
SECRET_PATH=darsai-webhook
# Optional. Telegram sends it in a header on every webhook call; derived from the bot token if empty.
# Allowed characters: A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=

# AI provider: groq | openrouter | openai
AI_PROVIDER=groq
AI_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AI_MEMORY_ENABLED=true
AI_MAX_HISTORY_MESSAGES=16
# AI capacity. Each tutor question sends the newest earlier questions and answers that fit this many tokens
# (estimated on the safe side), never more than AI_MAX_HISTORY_MESSAGES.
AI_HISTORY_TOKEN_BUDGET=1500
# Tutor questions at the same time (per server); a question waits this long for a free spot, then the student
# gets "the tutor is busy" (the message doesn't count). AI_DEADLINE_SECONDS: the most a question takes in all.
AI_MAX_CONCURRENT_CALLS=4
AI_QUEUE_WAIT_SECONDS=20
AI_DEADLINE_SECONDS=45
# "Too many requests" asking to wait at most this many seconds: wait and try once more (0 = never).
AI_RETRY_MAX_WAIT_SECONDS=5
# Longer tutor questions are refused before they count (long input costs tokens).
AI_MAX_QUESTION_CHARS=1500
# This many "tutor busy" refusals within this many minutes are one alert.
AI_BUSY_ALERT_THRESHOLD=10
AI_BUSY_ALERT_WINDOW_MINUTES=10
# Optional backup AI: groq | openrouter | openai, with its model (uses that provider's key above). Empty = off.
# Tried once when the main one is busy, down, too slow, refuses the key or lost the model. Groq lists its limits
# per model, so groq with another model may give extra room (check that its limits are separate). Another company
# is named in the privacy policy.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
# AI messages per user per UTC day. 0 = unlimited.
FREE_DAILY_AI_LIMIT=30

# Database (optional; without it everything is kept in memory and lost on restart)
DATABASE_URL=
DB_POOL_MAX_SIZE=5
# How long a database migration at startup waits for a busy table before it gives up (the deploy then fails and
# the old instance keeps running; the next start tries again).
MIGRATION_LOCK_TIMEOUT_SECONDS=5

BOT_NAME=DarsAI
# Optional: how students can contact you about their data (an email address or a Telegram @username), shown at the
# end of the privacy policy (/privacy). Empty: that line is left out.
PRIVACY_CONTACT=
# Telegram user ids allowed to use /stats and /alerttest, separated by commas. They also get the error alerts.
# Send /stats to the bot and the log shows your id.
ADMIN_USER_IDS=

# Error alerts. Every error in the log goes to the admins on Telegram (true by default); the same kind of error
# at most once per ALERT_REPEAT_MINUTES. Secrets and what students sent are left out.
ALERTS_TO_ADMINS=true
ALERT_REPEAT_MINUTES=30
# A short Telegram connection error (or flood-control wait) is only a warning in the log. This many within this
# many minutes are one error, and so one alert.
NETWORK_ALERT_THRESHOLD=5
NETWORK_ALERT_WINDOW_MINUTES=10
# Optional: Sentry too. Empty = off. SENTRY_ENVIRONMENT tells production, staging and local apart there.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Mini App (step 1: a reachability test for testers only). Testers get the 📚 menu button and /app, like the admins.
# Telegram user ids, separated by commas; a typo is skipped with a warning.
MINIAPP_TESTER_IDS=
# The page's public HTTPS address. Empty means WEBHOOK_URL + /app (the same service); "off" turns the buttons off.
MINIAPP_URL=
# Telegram's signed launch data older than this is refused (the student reopens the app).
MINIAPP_AUTH_MAX_AGE_SECONDS=3600
# Local testing only (run_local.py): the page is served on this port; LOCAL_MINIAPP_URL is a public HTTPS tunnel to it
# (e.g. `cloudflared tunnel --url http://localhost:8080`). Empty: no 📚 button for the test bot.
LOCAL_MINIAPP_URL=
LOCAL_MINIAPP_PORT=8080
